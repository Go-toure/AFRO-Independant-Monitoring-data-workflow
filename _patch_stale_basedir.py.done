    '  for (.aair_i in 1:6) {\n'
    '    .aair_candidate <- file.path(.aair_dir, "scripts", "find_workflow_home.R")\n'
    '    if (file.exists(.aair_candidate)) { .aair_fwh <- .aair_candidate; break }\n'
    '    .aair_parent <- dirname(.aair_dir)\n'
    '    if (identical(.aair_parent, .aair_dir)) break\n'
