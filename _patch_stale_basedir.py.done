    '  rm(.aair_dir, .aair_fwh, .aair_i, .aair_candidate)\n'
    '  if (exists(".aair_parent")) rm(.aair_parent)\n'
    '}\n',
    "AFRO_Advocacy_Intelligence_Report.R BASE_DIR",
)

# ------------------------------------------------------------------
# 6) scripts/afro_region_im_deck_generation.R (Step 4, source_safely())
#    -- uses its own `workflow_dir` variable name rather than BASE_DIR,
#    but the fix is the same idea: reuse run_workflow.R's BASE_DIR when
#    present, else resolve fresh.
# ------------------------------------------------------------------
apply(
    "scripts/afro_region_im_deck_generation.R",
    '# Main workflow directory\n'
    '# Set once via `setx IM_WORKFLOW_HOME "D:/new/path"` (Windows) if this\n'
    '# project ever moves off this laptop/drive -- every script in the pipeline\n'
    '# reads the same variable, so nothing else needs editing.\n'
    'workflow_dir <- Sys.getenv("IM_WORKFLOW_HOME", unset = "C:/Users/TOURE/Documents/im_workflow")\n',
    '# Main workflow directory. Reuse run_workflow.R\'s own BASE_DIR when\n'
    '# this script runs the normal way -- source_safely() from inside\n'
    '# run_workflow.R, for Step 4\'s optional reports -- it\'s already\n'
    '# resolved correctly in this same R session via the shared\n'
    '# find_workflow_home(). Only resolve it fresh for a standalone run.\n'
    '# This replaces a hardcoded Windows-laptop fallback path that was\n'
    '# silently wrong on Connect Cloud otherwise.\n'
    'if (exists("BASE_DIR", inherits = TRUE)) {\n'
    '  workflow_dir <- BASE_DIR\n'
    '} else {\n'
    '  .ardg_dir <- getwd()\n'
    '  .ardg_fwh <- NULL\n'
    '  for (.ardg_i in 1:6) {\n'
    '    .ardg_candidate <- file.path(.ardg_dir, "scripts", "find_workflow_home.R")\n'
    '    if (file.exists(.ardg_candidate)) { .ardg_fwh <- .ardg_candidate; break }\n'
    '    .ardg_parent <- dirname(.ardg_dir)\n'
    '    if (identical(.ardg_parent, .ardg_dir)) break\n'
    '    .ardg_dir <- .ardg_parent\n'
    '  }\n'
    '  if (is.null(.ardg_fwh))\n'
    '    stop("Could not locate scripts/find_workflow_home.R by searching upward from: ", getwd())\n'
    '  source(.ardg_fwh)\n'
    '  workflow_dir <- find_workflow_home()\n'
    '  rm(.ardg_dir, .ardg_fwh, .ardg_i, .ardg_candidate)\n'
    '  if (exists(".ardg_parent")) rm(.ardg_parent)\n'
    '}\n',
    "afro_region_im_deck_generation.R workflow_dir",
)

print("\nAll 6 patches applied successfully.")
