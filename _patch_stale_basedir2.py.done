    '# BASE_DIR is resolved by the shared find_workflow_home() (see\n'
    '# scripts/find_workflow_home.R\'s own header comment) instead of a\n'
    '# hardcoded fallback. This script always runs as its own Rscript\n'
    '# process (run_workflow.R\'s run_r_script()), so resolve\n'
    '# find_workflow_home.R via THIS SCRIPT\'S OWN FILE PATH -- exactly like\n'
    '# run_workflow.R does -- so it works no matter what working directory\n'
    '# the caller leaves us in. This replaces a stale hardcoded\n'
    '# Windows-laptop fallback that was silently pointing Connect Cloud at\n'
    '# a nonexistent path whenever IM_WORKFLOW_HOME wasn\'t set in the\n'
    '# environment -- which it never is when this is spawned by the Shiny\n'
    '# dashboard.\n'
    '.cg_this_file <- normalizePath(sub("^--file=", "",\n'
    '  grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)))\n'
    'source(file.path(dirname(.cg_this_file), "find_workflow_home.R"))\n'
    'rm(.cg_this_file)\n'
    'BASE_DIR <- find_workflow_home()\n',
    "clean_geonames.R BASE_DIR",
)

apply_crlf(
    "scripts/afro_im_intilligence_analysis_engine.R",
    '# BASE_DIR: set once via `setx IM_WORKFLOW_HOME "D:/new/path"` (Windows) if\n'
    '# this project ever moves off this laptop/drive -- every script in the\n'
    '# pipeline reads the same variable, so nothing else needs editing.\n'
    'BASE_DIR <- Sys.getenv("IM_WORKFLOW_HOME", unset = "C:/Users/TOURE/Documents/im_workflow")\n',
    '# BASE_DIR: when this script runs the normal way -- source_safely()\n'
    '# from inside run_workflow.R, for Step 4\'s optional reports --\n'
    '# run_workflow.R\'s own BASE_DIR (already resolved via the shared\n'
    '# find_workflow_home()) is sitting right there in this same R\n'
    '# session, so just reuse it. Only resolve it fresh (searching upward\n'
    '# from the working directory, same logic find_workflow_home() itself\n'
    '# uses) for a standalone run. This replaces a hardcoded Windows-laptop\n'
    '# fallback path that was silently wrong on Connect Cloud otherwise.\n'
    'if (!exists("BASE_DIR", inherits = TRUE)) {\n'
    '  .aiaee_dir <- getwd()\n'
    '  .aiaee_fwh <- NULL\n'
    '  for (.aiaee_i in 1:6) {\n'
    '    .aiaee_candidate <- file.path(.aiaee_dir, "scripts", "find_workflow_home.R")\n'
    '    if (file.exists(.aiaee_candidate)) { .aiaee_fwh <- .aiaee_candidate; break }\n'
    '    .aiaee_parent <- dirname(.aiaee_dir)\n'
    '    if (identical(.aiaee_parent, .aiaee_dir)) break\n'
    '    .aiaee_dir <- .aiaee_parent\n'
    '  }\n'
    '  if (is.null(.aiaee_fwh))\n'
    '    stop("Could not locate scripts/find_workflow_home.R by searching upward from: ", getwd())\n'
    '  source(.aiaee_fwh)\n'
    '  BASE_DIR <- find_workflow_home()\n'
    '  rm(.aiaee_dir, .aiaee_fwh, .aiaee_i, .aiaee_candidate)\n'
    '  if (exists(".aiaee_parent")) rm(.aiaee_parent)\n'
    '}\n',
    "afro_im_intilligence_analysis_engine.R BASE_DIR",
)

