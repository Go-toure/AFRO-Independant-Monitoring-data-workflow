import sys

def apply_crlf(path, old_lf, new_lf, label):
    old = old_lf.replace("\n", "\r\n")
    new = new_lf.replace("\n", "\r\n")
    with open(path, "r", newline="") as f:
        text = f.read()
    if old not in text:
        print(f"ERROR: anchor not found verbatim in {path} ({label}) -- aborting, no changes made to this file.")
        sys.exit(1)
    if text.count(old) > 1:
        print(f"ERROR: anchor found {text.count(old)} times in {path} ({label}) -- not unique, aborting.")
        sys.exit(1)
    text = text.replace(old, new)
    with open(path, "w", newline="") as f:
        f.write(text)
    print(f"Patched {path} ({label})")


apply_crlf(
    "scripts/regional_im_repository_builder.R",
    '# Set once via `setx IM_WORKFLOW_HOME "D:/new/path"` (Windows) if this\n'
    '# project ever moves off this laptop/drive -- every script in the pipeline\n'
    '# reads the same variable, so nothing else needs editing.\n'
    'base_dir <- Sys.getenv("IM_WORKFLOW_HOME", unset = "C:/Users/TOURE/Documents/im_workflow")\n',
    '# base_dir is resolved by the shared find_workflow_home() (see\n'
    '# scripts/find_workflow_home.R\'s own header comment) instead of a\n'
    '# hardcoded fallback. This script always runs as its own Rscript\n'
    '# process (run_workflow.R\'s run_r_script()), so resolve\n'
    '# find_workflow_home.R via THIS SCRIPT\'S OWN FILE PATH -- exactly like\n'
    '# run_workflow.R does -- so it works no matter what working directory\n'
    '# the caller leaves us in. This replaces a stale hardcoded\n'
    '# Windows-laptop fallback that was silently pointing Connect Cloud at\n'
    '# a nonexistent path whenever IM_WORKFLOW_HOME wasn\'t set in the\n'
    '# environment -- which it never is when this is spawned by the Shiny\n'
    '# dashboard.\n'
    '.ribr_this_file <- normalizePath(sub("^--file=", "",\n'
    '  grep("^--file=", commandArgs(trailingOnly = FALSE), value = TRUE)))\n'
    'source(file.path(dirname(.ribr_this_file), "find_workflow_home.R"))\n'
    'rm(.ribr_this_file)\n'
    'base_dir <- find_workflow_home()\n',
    "regional_im_repository_builder.R base_dir",
)

