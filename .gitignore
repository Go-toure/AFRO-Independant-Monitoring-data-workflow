# ============================================================
# im_workflow / AFRO_Independant_Monitoring_data_workflow
# ============================================================

# Data & generated outputs — not source, regenerated by the pipeline
data/
outputs/
logs/
scripts/logs/

# R workspace / history — machine-specific, not source
.RData
.Rhistory
.Rproj.user/

# Stray backup copy of the Shiny app — app.R is the tracked source
shiny_app/app.R - copie

# Secrets — real credentials must never be committed
config/secrets.env

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.pyc
__pycache__/
