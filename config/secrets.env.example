# Copy this file to config/secrets.env and fill in the real values.
# config/secrets.env is listed in .gitignore — it must NEVER be committed.
#
# Loaded automatically by scripts/_env_loader.py (upload_to_sharepoint.py,
# Fetch_im_data.py, and send_failure_alert.py all call it on startup). A
# variable already set in your real shell environment (via `setx` /
# `export`) always takes priority over this file.

# SharePoint (Microsoft Graph) app registration — used by
# scripts/upload_to_sharepoint.py
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# poliogo.afro.who.int (GPEI) API token — used by
# scripts/refresh_preparedness_lookup.py to fetch the campaign calendar
# (lookup.xlsx) directly from the site's own REST API. Get this from
# https://poliogo.afro.who.int/dashboard/api/apitoken while logged in
# (the site used to be www.poliooutbreaks.com with a fillable login
# form; it moved to poliogo.afro.who.int and now requires WHO SSO, so
# this token is the only way to fetch data non-interactively). Treat it
# exactly like a password.
GPEI_API_TOKEN=

# ONA / WHONgHub API token — used by scripts/Fetch_im_data.py
ONA_API_TOKEN=

# Anthropic API key — powers the "AFRO IM Assistant" floating chat widget
# in the Shiny dashboard (shiny_app/app.R). Get one at https://console.anthropic.com
# (Settings → API Keys). Leave blank to keep the assistant disabled.
ANTHROPIC_API_KEY=

# Failure alert email — sent by scripts/send_failure_alert.py when the
# unattended nightly run (Mon-Fri 11pm, run_workflow_nightly.bat) fails, so
# a failure doesn't sit unnoticed until someone opens the dashboard. Uses
# Gmail's SMTP-over-STARTTLS by default (ALERT_SMTP_HOST/PORT below only
# need filling in for a different provider).
#
# ALERT_EMAIL_FROM / ALERT_EMAIL_APP_PASSWORD: the sending account. For
# Gmail, this must be an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords), NOT your normal login password -- Gmail
# blocks plain-password SMTP logins.
# ALERT_EMAIL_TO: where the alert should land (can be the same address).
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_APP_PASSWORD=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=
